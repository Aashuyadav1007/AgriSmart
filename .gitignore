# =============================================================================
# AgriMind AI – Project-Level Git Ignore
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
develop-eggs/
dist/
/downloads/
eggs/
.eggs/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Node & Frontend Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/vite.config.js.timestamp-*
.eslintcache

# Sensitive Environment & Credentials
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.local

# Keep templates tracked
!backend/.env.example
!frontend/.env.example

# Large Datasets, Raw Images, and Downloaded Archives
backend/data/downloads/*.zip
backend/data/downloads/*.part
!backend/data/downloads/*.txt
!backend/data/downloads/*.sha256
!backend/data/downloads/*.md
backend/data/plantvillage_mendeley_extracted/
backend/data/consolidated_staging_42_classes/
backend/data/plantvillage_dataset/
backend/data/holdout_test_images/

# Temporary Scratch Scripts
backend/scratch_*.py

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# System & Editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
